<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Sélecteur de destinataires</masterLabel>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property
                name="maxResults"
                type="Integer"
                default="10"
                min="1"
                max="50"
                label="Nombre maximum de résultats"
                description="Nombre maximum de contacts affichés lors de la recherche (1 à 50)"
            />
        </targetConfig>
        <targetConfig targets="lightning__FlowScreen">
            <property
                name="recordId"
                type="String"
                role="inputOnly"
                label="ID de l'opportunité de financement"
                description="Non utilisé par le composant : conservé car des versions du flow y font référence"
            />
            <property
                name="maxResults"
                type="Integer"
                default="10"
                role="inputOnly"
                label="Nombre maximum de résultats"
                description="Nombre maximum de contacts affichés lors de la recherche (1 à 50)"
            />
            <property
                name="selectedIds"
                type="String[]"
                role="outputOnly"
                label="Destinataires sélectionnés (IDs)"
                description="IDs des contacts sélectionnés"
            />
            <property
                name="selectedEmails"
                type="String[]"
                role="outputOnly"
                label="Adresses e-mail saisies"
                description="Adresses e-mail ajoutées manuellement"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>