<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Application Form Budget Table</masterLabel>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>ApplicationForm</object>
            </objects>
            <property name="readOnly" type="Boolean" label="Read only" default="false" />
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="recordId" type="String" label="Application Form Id" />
            <property name="fundingOpportunityId" type="String" label="Funding Opportunity Id" />
            <property name="readOnly" type="Boolean" label="Read only" default="false" />
        </targetConfig>
        <targetConfig targets="lightningCommunity__Default">
            <property name="recordId" type="String" label="Application Form Id" default="{!recordId}" />
            <property name="fundingOpportunityId" type="String" label="Funding Opportunity Id" />
            <property name="readOnly" type="Boolean" label="Read only" default="false" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
