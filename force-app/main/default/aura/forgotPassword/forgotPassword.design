<design:component label="Custom Forgot Password">
    <design:attribute name="checkEmailUrl" default="./CheckPasswordResetEmail"/>
    <design:attribute name="usernameLabel" label="Email field label" default="Email"/>
    <design:attribute name="submitButtonLabel" label="Button label" default="Send"/>
    <design:attribute name="helpText" label="Help text under the field" default="Enter your email address to request a password reset."/>
</design:component>