<aura:component implements="forceCommunity:layout" description="AXA user interface forgot password layout" access="global">
    <aura:attribute name="content" type="Aura.Component[]" required="false" description="Page content (e.g. standard forgot password form)"/>
    <aura:attribute name="pleaseRead" type="Aura.Component[]" required="false" description="Please read section (e.g. a rich text component)"/>

    <div class="layout-forgot-password page-wrapper">
        <c:forgotPasswordHeader />

        <div class="forgot-main">
            <div class="forgot-container">
                <h1 class="forgot-title">Forgot your password?</h1>

                <div class="forgot-form-region">
                    {!v.content}
                </div>

                <div class="please-read-region">
                    {!v.pleaseRead}
                </div>
            </div>
        </div>
    </div>
</aura:component>